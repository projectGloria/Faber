{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: folder picker, store for recents/overrides, opener for revealing artifacts, and window controls for the custom title bar. Process spawning lives in Rust commands, never the webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "store:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-request-user-attention"
  ]
}
